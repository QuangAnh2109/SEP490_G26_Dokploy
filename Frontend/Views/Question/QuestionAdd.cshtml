@{
    Layout = null;
}
<!doctype html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thêm câu hỏi</title>
  <link rel="stylesheet" href="/vendor/bootstrap-5.3.8/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/Exam_preview.css">
  <link rel="stylesheet" href="/css/question_add.css">
  <script defer src="https://unpkg.com/mathlive"></script>
</head>

<body>
  <main class="page-shell py-4">
    <div class="container-fluid px-3 px-md-4">
      <section class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
          <h1 class="page-title">Thêm câu hỏi</h1>
          <p class="page-subtitle">Thêm nhiều câu hỏi vào ngân hàng câu hỏi của giáo viên trên cùng một màn hình.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-outline-secondary" data-bs-toggle="modal"
            data-bs-target="#questionImportModal">Nhập</button>
          <a class="btn btn-outline-secondary" href="/Question">Hủy</a>
          <button class="btn btn-outline-secondary" id="saveDraftBtn">Lưu nháp</button>
          <button class="btn btn-primary" id="saveAllBtn">Lưu tất cả</button>
        </div>
      </section>

      <section class="panel-card mb-3">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
          <div>
            <h2 class="section-title mb-1">Thêm nhiều câu hỏi trong một lần</h2>
            <p class="form-note mb-0">Mỗi giáo viên chỉ có một ngân hàng câu hỏi duy nhất.</p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="form-note mb-0" id="questionCountText">Đang soạn: 1 câu hỏi</span>
            <button class="btn btn-outline-primary" type="button" id="addQuestionItemBtn">Thêm câu hỏi mới</button>
          </div>
        </div>
      </section>

      <div class="vstack gap-3" id="questionBatchList">
        <section class="form-section" data-question-item data-question-index="1">
          <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <h2 class="section-title mb-0" data-question-title>Câu hỏi #1</h2>
            <button class="btn btn-sm btn-outline-danger" type="button" data-remove-question>Xóa câu hỏi</button>
          </div>
          <div class="row g-3">
            <div class="col-12 col-xl-8">
              <div class="row g-2 mb-2">
                <div class="col-12 col-md-6">
                  <label class="form-label">Loại câu hỏi</label>
                  <select class="form-select" data-question-type-select>
                    <option value="fill_blank" selected>Điền vào ô trống</option>
                    <option value="mcq">Trắc nghiệm</option>
                  </select>
                </div>
              </div>
              <label class="form-label">Đề bài</label>
              <math-field class="math-input" data-question-stem></math-field>
              <textarea class="math-raw-textarea d-none" rows="2" data-stem-raw
                placeholder="Nhập LaTeX cho đề bài..."></textarea>
              <div class="render-toggle-bar">
                <div class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" role="switch" id="stemRenderToggle1"
                    data-stem-render-toggle checked>
                  <label class="form-check-label" for="stemRenderToggle1">Hiển thị dạng toán học</label>
                </div>
                <span class="form-note">Tắt để chỉnh sửa dạng văn bản thuần (LaTeX)</span>
              </div>
              <hr class="section-divider">

              <!-- ═══ FILL BLANK ═══ -->
              <section class="question-type-panel" data-question-type-panel="fill_blank">
                <h3 class="section-title">Điền vào ô trống</h3>
                <label class="form-label">Khung trả lời — gõ <code>\placeholder{1}</code>, <code>\placeholder{2}</code>…
                  để tạo ô trống có đánh số</label>
                <math-field class="math-input" data-frame-editor></math-field>
                <textarea class="math-raw-textarea d-none" rows="2" data-frame-raw
                  placeholder="Nhập LaTeX..."></textarea>
                <div class="render-toggle-bar">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="renderToggle1" data-render-toggle
                      checked>
                    <label class="form-check-label" for="renderToggle1">Hiển thị dạng toán học</label>
                  </div>
                  <span class="form-note">Tắt để chỉnh sửa dạng văn bản thuần (LaTeX)</span>
                </div>
                <div class="toolbar mt-2">
                  <button class="btn btn-outline-secondary" type="button" data-insert-placeholder>Chèn ô trống</button>
                  <span class="form-note mb-0" data-placeholder-count>0 ô trống</span>
                </div>
                <!-- Scoring toggle -->
                <div class="scoring-toggle-bar" data-scoring-toggle-bar>
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="scoringToggle1"
                      data-scoring-toggle>
                    <label class="form-check-label" for="scoringToggle1">Đặt hệ số điểm riêng cho từng ô trống</label>
                  </div>
                  <span class="form-note">Khi tắt, tất cả ô trống có điểm bằng nhau.</span>
                </div>
                <p class="field-help mt-2 mb-0" data-blank-answer-empty>Chưa có ô trống có đánh số trong khung. Hãy dùng
                  <code>\placeholder{1}</code> để tạo ô trống.
                </p>
                <div class="blank-answer-list mt-2 d-none" data-blank-answer-list>
                  <!-- Blank rows rendered dynamically -->
                </div>
                <!-- Score summary -->
                <div class="score-summary-bar mt-2 d-none" data-score-summary>
                  <strong>Tổng hệ số điểm:</strong> <span data-score-total>0</span>% / 100%
                </div>
              </section>

              <!-- ═══ MCQ ═══ -->
              <section class="question-type-panel d-none" data-question-type-panel="mcq">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                  <div>
                    <h3 class="section-title mb-0">Trắc nghiệm</h3>
                    <span class="mcq-multi-note mt-1 d-inline-flex">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                        viewBox="0 0 16 16">
                        <path
                          d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z" />
                        <path
                          d="M10.97 4.97a.75.75 0 0 1 1.071 1.05l-3.992 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z" />
                      </svg>
                      Cho phép chọn nhiều đáp án đúng
                    </span>
                  </div>
                  <button class="btn btn-outline-secondary" type="button" data-add-answer="q-mcq-opts-1">Thêm lựa
                    chọn</button>
                </div>
                <div class="render-toggle-bar mb-2">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="mcqRenderToggle1"
                      data-mcq-render-toggle checked>
                    <label class="form-check-label" for="mcqRenderToggle1">Hiển thị dạng toán học</label>
                  </div>
                  <span class="form-note">Tắt để chỉnh sửa tất cả đáp án dạng văn bản thuần (LaTeX)</span>
                </div>
                <div id="q-mcq-opts-1" data-answer-list>
                  <div class="answer-row" data-answer-item>
                    <div class="d-flex align-items-center gap-2"><span class="input-group-text"
                        data-answer-index>A</span><math-field class="math-input flex-grow-1"
                        data-option-content></math-field><textarea class="math-raw-textarea flex-grow-1 d-none" rows="1"
                        data-option-raw></textarea></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" data-option-correct><label
                        class="form-check-label" data-option-correct-label>Đúng</label></div><button
                      class="btn btn-outline-danger" type="button" data-remove-answer>Xóa</button>
                  </div>
                  <div class="answer-row" data-answer-item>
                    <div class="d-flex align-items-center gap-2"><span class="input-group-text"
                        data-answer-index>B</span><math-field class="math-input flex-grow-1"
                        data-option-content></math-field><textarea class="math-raw-textarea flex-grow-1 d-none" rows="1"
                        data-option-raw></textarea></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" data-option-correct><label
                        class="form-check-label" data-option-correct-label>Đúng</label></div><button
                      class="btn btn-outline-danger" type="button" data-remove-answer>Xóa</button>
                  </div>
                  <div class="answer-row" data-answer-item>
                    <div class="d-flex align-items-center gap-2"><span class="input-group-text"
                        data-answer-index>C</span><math-field class="math-input flex-grow-1"
                        data-option-content></math-field><textarea class="math-raw-textarea flex-grow-1 d-none" rows="1"
                        data-option-raw></textarea></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" data-option-correct><label
                        class="form-check-label" data-option-correct-label>Đúng</label></div><button
                      class="btn btn-outline-danger" type="button" data-remove-answer>Xóa</button>
                  </div>
                  <div class="answer-row" data-answer-item>
                    <div class="d-flex align-items-center gap-2"><span class="input-group-text"
                        data-answer-index>D</span><math-field class="math-input flex-grow-1"
                        data-option-content></math-field><textarea class="math-raw-textarea flex-grow-1 d-none" rows="1"
                        data-option-raw></textarea></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" data-option-correct><label
                        class="form-check-label" data-option-correct-label>Đúng</label></div><button
                      class="btn btn-outline-danger" type="button" data-remove-answer>Xóa</button>
                  </div>
                  <div class="answer-row d-none" data-answer-template>
                    <div class="d-flex align-items-center gap-2"><span class="input-group-text"
                        data-answer-index>Z</span><math-field class="math-input flex-grow-1"
                        data-option-content></math-field><textarea class="math-raw-textarea flex-grow-1 d-none" rows="1"
                        data-option-raw></textarea></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" data-option-correct><label
                        class="form-check-label" data-option-correct-label>Đúng</label></div><button
                      class="btn btn-outline-danger" type="button" data-remove-answer>Xóa</button>
                  </div>
                </div>
                <p class="field-help mt-2 mb-0">Đánh dấu một hoặc nhiều đáp án đúng.</p>
                <!-- MCQ score -->
                <div class="score-summary-bar mt-2" data-mcq-score-bar>
                  <label class="form-label mb-0 me-2"><strong>Hệ số điểm (%):</strong></label>
                  <input class="form-control form-control-sm" type="number" value="0" min="0" max="100" step="1"
                    style="width:100px" data-mcq-score>
                </div>
              </section>

              <hr class="section-divider">
              <label class="form-label">Giải thích</label>
              <textarea class="form-control" rows="3" placeholder="Nhập lời giải thích cho câu hỏi" data-explanation></textarea>
            </div>

            <div class="col-12 col-xl-4">
              <section class="soft-card">
                <h3 class="section-title">Thông tin phân loại</h3>
                <label class="form-label">Môn học</label>
                <select class="form-select mb-2" data-subject-select>
                  <option value="">Chọn môn học</option>
                </select>
                <label class="form-label">Chương</label>
                <select class="form-select mb-2" data-chapter-select>
                  <option value="">Chọn chương</option>
                </select>
                <label class="form-label">Mức độ</label>
                <select class="form-select mb-2" data-difficulty-select>
                  <option value="1">Nhận biết</option>
                  <option value="2">Thông hiểu</option>
                  <option value="3">Vận dụng</option>
                  <option value="4">Vận dụng cao</option>
                </select>
              </section>

              <!-- ═══ BLANK GROUPS ═══ -->
              <section class="blank-group-section" data-blank-group-section>
                <div class="blank-group-card">
                  <h3 class="section-title">Nhóm ô trống</h3>
                  <p class="form-note mb-2">Nhóm các dòng trong khung trả lời lại để chấm điểm hoặc xử lý cùng nhau.
                    Mỗi dòng (phân tách bởi <code>\\</code>) sẽ xuất hiện để chọn vào nhóm.</p>
                  <p class="form-note mb-2 d-none" data-blank-group-no-placeholders>
                    <em>Chưa có nội dung. Hãy nhập biểu thức với <code>\placeholder{n}</code> trong khung trả lời.</em>
                  </p>
                  <div class="blank-group-list" data-blank-group-list>
                  </div>
                  <button type="button" class="blank-group-add-btn mt-2" data-add-blank-group>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path
                        d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                    </svg>
                    Thêm nhóm mới
                  </button>
                </div>
              </section>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <div class="modal fade" id="questionImportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5">Nhập câu hỏi</h2><button type="button" class="btn-close" data-bs-dismiss="modal"
            aria-label="Đóng"></button>
        </div>
        <form class="modal-body" data-import-form data-allowed-ext=".csv,.xlsx,.json">
          <div class="mb-2"><label class="form-label">Chọn tệp nguồn</label><input class="form-control" type="file"
              data-import-file></div>
          <div class="mb-2"><label class="form-label">Chế độ nhập</label><select class="form-select">
              <option>Thêm mới (Append)</option>
              <option>Ghi đè (Replace)</option>
              <option>Chỉ kiểm tra (Validate only)</option>
            </select></div>
          <div class="import-result" data-import-result></div>
          <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" class="btn btn-outline-secondary"
              data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary">Nhập dữ liệu mô
              phỏng</button></div>
        </form>
      </div>
    </div>
  </div>

  <script src="/lib/jquery/dist/jquery.min.js"></script>
  <script src="/vendor/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
  <script src="/js/site.js"></script>
  <script src="/js/question_add.js"></script>
</body>

</html>
