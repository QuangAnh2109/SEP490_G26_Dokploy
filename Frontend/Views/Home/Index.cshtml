@{
    ViewData["Title"] = "Hệ thống Quản lý Khảo thí MTCA";
    ViewBag.HideSidebar = true;
    ViewBag.IsFullWidth = true;
}

<div class="home-hero py-5 position-relative overflow-hidden">
    <!-- Mathematical Accents -->
    <div class="math-accent math-accent-1">Σ</div>
    <div class="math-accent math-accent-2">π</div>
    <div class="math-accent math-accent-3">Δ</div>
    <div class="math-accent math-accent-4">∫</div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-7 text-start">
                <h6 class="text-primary fw-bold text-uppercase mb-3 ls-1">Nền tảng Quản lý Khảo thí Thông minh</h6>
                <h1 class="display-3 fw-bold mb-4 math-serif text-dark">
                    Nâng tầm kiến thức qua <span class="text-primary">Con số</span>
                </h1>
                <p class="lead text-muted mb-5 fs-5">
                    Hệ thống quản lý học tập và đánh giá toàn diện, được thiết kế tối ưu cho trải nghiệm giảng dạy và kiểm tra hiện đại.
                </p>
                
                <div id="guestActions" class="d-flex gap-3">
                    <a href="/Auth/Login" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-premium transition-all hover-translate">
                        Bắt đầu ngay <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>

                <div id="authRequiredActions" class="d-none">
                    <a href="/Class/ClassList" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-premium transition-all hover-translate">
                        Đến Lớp học của tôi <i class="fas fa-chalkboard-teacher ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-visual position-relative">
                    <div class="geometric-shape circle-1"></div>
                    <div class="geometric-shape square-1"></div>
                    <div class="glass-card p-4 shadow-lg border-math">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-primary-soft text-primary me-3">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">Kết quả học tập</h5>
                                <small class="text-muted">Cập nhật 2 phút trước</small>
                            </div>
                        </div>
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar bg-primary" style="width: 85%"></div>
                        </div>
                        <div class="d-flex justify-content-between small fw-medium">
                            <span>Tiến độ hoàn thành</span>
                            <span>85%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5 pt-5 gx-4">
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white shadow-sm border-math hover-lift transition-all">
                    <div class="feature-icon mb-4"><i class="fas fa-brain fa-2x text-primary"></i></div>
                    <h4 class="math-serif mb-3">Tự động hóa</h4>
                    <p class="text-muted">Tạo đề thi và chấm điểm tự động dựa trên ngân hàng câu hỏi thông minh.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white shadow-sm border-math hover-lift transition-all">
                    <div class="feature-icon mb-4"><i class="fas fa-microchip fa-2x text-info"></i></div>
                    <h4 class="math-serif mb-3">Phân tích sâu</h4>
                    <p class="text-muted">Theo dõi tiến độ học sinh và phân tích chất lượng đề thi bằng biểu đồ trực quan.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white shadow-sm border-math hover-lift transition-all">
                    <div class="feature-icon mb-4"><i class="fas fa-shield-halved fa-2x text-success"></i></div>
                    <h4 class="math-serif mb-3">Bảo mật tuyệt đối</h4>
                    <p class="text-muted">Đảm bảo tính minh bạch và bảo mật dữ liệu cho mọi kỳ thi của bạn.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .home-hero {
        min-height: 80vh;
        display: flex;
        align-items: center;
    }

    .ls-1 { letter-spacing: 0.1em; }

    .shadow-premium {
        box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.5);
    }

    .transition-all {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hover-translate:hover {
        transform: translateY(-3px);
    }

    .hover-lift:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1) !important;
    }

    .border-math {
        border: 1px solid rgba(37, 99, 235, 0.1);
        border-radius: 1.5rem;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 2rem;
        transform: rotate(-2deg);
        z-index: 5;
        position: relative;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-soft { background-color: rgba(37, 99, 235, 0.1); }

    .math-accent {
        position: absolute;
        font-family: var(--font-serif);
        font-size: 8rem;
        color: rgba(37, 99, 235, 0.03);
        pointer-events: none;
        z-index: 1;
        font-weight: bold;
    }

    .math-accent-1 { top: 10%; right: 5%; transform: rotate(15deg); animation: float 6s ease-in-out infinite; }
    .math-accent-2 { bottom: 10%; left: 0%; transform: rotate(-20deg); font-size: 12rem; animation: float 8s ease-in-out infinite 1s; }
    .math-accent-3 { top: 40%; right: 40%; transform: rotate(-5deg); font-size: 6rem; animation: float 7s ease-in-out infinite 0.5s; }
    .math-accent-4 { top: -5%; left: 20%; transform: rotate(10deg); font-size: 10rem; animation: float 9s ease-in-out infinite 2s; }

    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
        50% { transform: translateY(-20px) rotate(calc(var(--rot, 0deg) + 5deg)); }
    }

    .math-accent-1 { --rot: 15deg; }
    .math-accent-2 { --rot: -20deg; }
    .math-accent-3 { --rot: -5deg; }
    .math-accent-4 { --rot: 10deg; }

    .geometric-shape {
        position: absolute;
        pointer-events: none;
        z-index: 0;
    }

    .circle-1 {
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
        border-radius: 50%;
        top: -50px;
        right: -50px;
    }

    .square-1 {
        width: 150px;
        height: 150px;
        border: 2px solid rgba(37, 99, 235, 0.05);
        border-radius: 30px;
        top: 150px;
        right: 150px;
        transform: rotate(45deg);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof setBreadcrumb === 'function') {
                setBreadcrumb([]);
            }
            // Check if user is logged in
            const token = sessionStorage.getItem("jwtToken") || localStorage.getItem("jwtToken");
            
            if (token) {
                // User is authenticated
                document.getElementById("guestActions").classList.add("d-none");
                document.getElementById("authRequiredActions").classList.remove("d-none");
            } else {
                // User is guest
                document.getElementById("guestActions").classList.remove("d-none");
                document.getElementById("authRequiredActions").classList.add("d-none");
            }
        });
    </script>
}
