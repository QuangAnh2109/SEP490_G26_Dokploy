<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Danh sách lớp học</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5.3.8 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (cho icon kính lúp) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Inline CSS để giống ảnh -->
    <style>
        :root{
          --card-radius: 14px;
          --brand-blue: #2F6FED;     /* màu nút xanh trong ảnh */
          --muted: #6B7280;          /* xám nhẹ subtitle */
          --bg-soft: #F5F6FA;        /* nền trang */
          --border-soft: #F0F1F5;
        }
        body{
          background: var(--bg-soft);
        }
        .page-shell{
          padding-top: 24px;
          padding-bottom: 24px;
        }
        /* Header */
        .page-header h1{
          font-weight: 600;
          font-size: 1.6rem;
          margin-bottom: .25rem;
        }
        .page-subtitle{
          color: var(--muted);
          margin: 0;
        }
        /* Button tạo lớp/tham gia lớp */
        .btn-primary{
          background: var(--brand-blue);
          border-color: var(--brand-blue);
          border-radius: 10px;
          padding-inline: 16px;
          font-weight: 600;
        }
        .btn-primary:hover{
          filter: brightness(0.95);
          background: var(--brand-blue);
          border-color: var(--brand-blue);
          color: white;
        }
        /* Panel tìm kiếm + filter */
        .panel-card{
          background: #fff;
          border: 1px solid var(--border-soft);
          border-radius: var(--card-radius);
          box-shadow: 0 6px 18px rgba(16,24,40,0.05);
          padding: 16px;
        }
        .input-group .input-group-text{
          background: #fff;
          border-right: 0;
          border-radius: 12px 0 0 12px;
        }
        .input-group .form-control{
          border-left: 0;
          border-radius: 0 12px 12px 0;
          padding-top: .6rem;
          padding-bottom: .6rem;
        }
        .form-select{
          border-radius: 12px;
          padding-top: .6rem;
          padding-bottom: .6rem;
        }
        /* Grid card */
        #courseGrid .col-12.col-sm-6.col-lg-3{
          /* đảm bảo spacing giống ảnh */
        }
        .class-card.card{
          border: 1px solid var(--border-soft);
          border-radius: var(--card-radius);
          box-shadow: 0 6px 18px rgba(16,24,40,0.05);
          transition: transform .15s ease, box-shadow .15s ease;
        }
        .class-card.card:hover{
          transform: translateY(-2px);
          box-shadow: 0 12px 24px rgba(16,24,40,0.08);
        }
        .class-card .card-body h5{
          font-weight: 600;
          margin-bottom: 0.25rem;
        }
        .class-card .card-body small.text-muted{
          color: #98A2B3 !important;
        }
        .btn-enter{
          background: var(--brand-blue);
          border-color: var(--brand-blue);
          border-radius: 10px;
          font-weight: 600;
          color:white;
        }
        .btn-enter:hover{
          filter: brightness(0.95);
          background: var(--brand-blue);
          border-color: var(--brand-blue);
        }
        /* Modal bo tròn */
        .modal-content{
          border-radius: 14px;
        }
    </style>
</head>
<body>

    <main class="page-shell">
        <div class="container-fluid px-3 px-md-4">

            <!-- HEADER -->
            <section class="page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 id="pageTitle"></h1>
                    <p class="page-subtitle" id="pageSubtitle"></p>
                </div>
                <div id="actionButtonContainer"></div>
            </section>

            <!-- SEARCH + FILTER -->
            <section class="panel-card mb-4">
                <div class="row g-3 align-items-center">
                    <!-- SEARCH -->
                    <div class="col-12 col-lg-6">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   id="courseSearchInput"
                                   placeholder="Tìm theo tên lớp hoặc giảng viên">
                        </div>
                    </div>
                    <!-- SEMESTER -->
                    <div class="col-6 col-lg-3">
                        <select class="form-select" id="courseSemesterFilter">
                            <option value="">Tất cả</option>
                        </select>
                    </div>
                    <!-- SUBJECT -->
                    <div class="col-6 col-lg-3">
                        <select class="form-select" id="courseSubjectFilter">
                            <option value="">Tất cả</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- GRID -->
            <section class="row g-4" id="courseGrid"></section>

        </div>
    </main>

    <!-- JOIN CLASS MODAL -->
    <div class="modal fade" id="joinClassModal" tabindex="-1" aria-labelledby="joinClassModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="joinClassForm">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="joinClassModalLabel">Nhập mã mời vào lớp</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="joinClassCodeInput">Mã mời *</label>
                    <input class="form-control" id="joinClassCodeInput" placeholder="Nhập mã mời (ví dụ: SE1711)" autocomplete="off" required>
                    <p class="mt-2 mb-0 text-muted">Nhập mã mời do giảng viên cung cấp để tham gia lớp học.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Xác nhận tham gia</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS (Bundle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Course/Course.js"></script>
    <!-- Inline JS: giữ nguyên logic gốc, chỉ đổi markup ở render -->
