@{
    ViewData["Title"] = "Cài đặt lớp học";
    var classId = ViewBag.ClassId ?? 0;
    var className = ViewBag.ClassName as string;
    var classNameParam = !string.IsNullOrEmpty(className) ? "?className=" + Uri.EscapeDataString(className) : "";
    ViewBag.IsFullWidth = true;
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Course/course_sidebar.css" asp-append-version="true" />
    <style>
        .form-switch .form-check-input {
            width: 3em;
            height: 1.5em;
        }
    </style>
}

<div class="course-wrapper">
    <!-- Sidebar -->
    <aside class="course-sidebar">
        <div class="mb-4">
            <h6 class="fw-bold text-primary mb-1">Quản lý lớp học</h6>
            <div class="text-muted small" id="sidebarClassName">---</div>
        </div>

        <div class="nav-section-title">Bài thi</div>
        <a href="/Course/ExamListInCourse/@classId@classNameParam" class="sidebar-link">
            <i class="fas fa-list"></i> Danh sách đề
        </a>
        <a href="/PracticeExam/Setup?classId=@classId" class="sidebar-link" id="practiceMenuItem">
            <i class="fas fa-brain"></i> Luyện tập
        </a>
        <a href="/PracticeExam/History?classId=@classId" class="sidebar-link" id="practiceHistoryMenuItem">
            <i class="fas fa-chart-bar"></i> Kết quả
        </a>

        <div class="nav-section-title">Quản lý</div>
        <a href="/Course/StudentList/@classId@classNameParam" class="sidebar-link">
            <i class="fas fa-users"></i> Danh sách học sinh
        </a>
        <a href="/Course/PendingStudents/@classId@classNameParam" class="sidebar-link">
            <i class="fas fa-user-clock"></i> Phê duyệt học sinh
        </a>
        <a href="/Course/Settings/@classId@classNameParam" id="settingsMenuItem" class="sidebar-link active">
            <i class="fas fa-cog"></i> Cài đặt
        </a>
    </aside>

    <!-- Main Content -->
    <main class="course-content">

        <section class="mb-4">
            <h2 class="fw-bold">Cài đặt lớp học</h2>
        </section>

        <section class="card p-4 mx-auto" style="max-width: 800px;">
            <form id="settingsForm">
                <!-- Tên lớp -->
                <div class="mb-4">
                    <label for="classNameInput" class="form-label fw-bold">Tên lớp học</label>
                    <input type="text" class="form-control" id="classNameInput" required>
                </div>

                <!-- Môn & Kỳ (Readonly) -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Môn học</label>
                        <input type="text" class="form-control bg-light" id="subjectInput" readonly>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <label class="form-label fw-bold">Học kỳ</label>
                        <input type="text" class="form-control bg-light" id="semesterInput" readonly>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Mã mời -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label fw-bold mb-0">Mã mời vào lớp</label>
                        <div class="form-check form-switch ps-0 m-0 d-flex align-items-center">
                            <label class="form-check-label me-5" for="invitationStatusSwitch">Cho phép dùng mã mời</label>
                            <input class="form-check-input m-0 ms-2" type="checkbox" role="switch" id="invitationStatusSwitch" checked onchange="toggleInviteVisibility()">
                        </div>
                    </div>

                    <div id="inviteContentArea">
                        <div class="input-group mb-2">
                            <span class="input-group-text">Code</span>
                            <input type="text" class="form-control bg-light fs-5 font-monospace text-primary" id="inviteCodeInput" readonly>
                            <button class="btn btn-outline-primary" type="button" onclick="showInviteDetails()" title="Xem chi tiết">
                                <i class="fas fa-eye me-1"></i> Xem chi tiết
                            </button>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            Học sinh có thể tham gia lớp học bằng cách nhập mã code này, hoặc truy cập trực tiếp bằng đường link mời.
                        </small>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Mời qua Email -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Mời trực tiếp qua Email</label>
                    <div class="input-group">
                        <input type="email" class="form-control" id="inviteEmailInput" placeholder="Nhập địa chỉ email học sinh...">
                        <button class="btn btn-success" type="button" onclick="inviteStudentByEmail()" id="btnInviteEmail">
                            Gửi lời mời <i class="fas fa-paper-plane ms-1"></i>
                        </button>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Trạng thái lớp học -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-danger">Trạng thái lớp học</label>
                    <div class="d-flex justify-content-between align-items-center p-3 rounded border" id="classStatusContainer">
                        <div>
                            <h6 class="mb-1 fw-bold" id="classStatusTitle">Đang hoạt động</h6>
                            <p class="text-muted mb-0 small" id="classStatusDesc">Học sinh có thể làm bài. Giáo viên có thể chỉnh sửa cài đặt và quản lý lớp.</p>
                        </div>
                        <button class="btn btn-outline-danger" type="button" id="btnToggleClassStatus" onclick="toggleClassStatus()">
                            Đóng lớp học
                        </button>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Nút lưu -->
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4 py-2" id="saveButton">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </section>

    </main>
</div>

<!-- Modal Chi tiết mã mời -->
<div class="modal fade" id="inviteDetailsModal" tabindex="-1" aria-labelledby="inviteDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inviteDetailsModalLabel">Chi tiết mã mời</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-4">
                    <label class="form-label fw-bold text-start w-100">Mã code</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light fs-4 font-monospace text-primary text-center" id="modalCodeInput" readonly>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('modalCodeInput')" title="Sao chép Code">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-start w-100">Link mời</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light text-primary" id="modalLinkInput" readonly>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('modalLinkInput')" title="Sao chép Link">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold text-start w-100">Mã QR</label>
                    <div class="border rounded p-3 bg-light d-inline-block">
                        <img id="qrCodeImage" src="" alt="QR Code" style="width: 150px; height: 150px; display: none;" />
                        <div id="qrLoading" class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/vendor/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <div id="courseData" data-class-id="@classId" data-class-name="@className" style="display: none;"></div>
    <script>
        const API_BASE = window.API_BASE_URL;
    </script>
    <script src="~/js/Course/settings.js" asp-append-version="true"></script>
}
