@{
    ViewData["Title"] = "Danh sách học sinh";
    var classId = ViewBag.ClassId ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .search-box {
            max-width: 350px;
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 8px;
        }
    </style>
}

<div class="d-flex" style="min-height: 100vh;">
    <!-- Sidebar -->
    <aside class="bg-light border-end" style="width: 250px;">
        <div class="p-3 border-bottom">
            <h5 class="mb-0">Quản lý lớp học</h5>
        </div>
        <div class="list-group list-group-flush">
            <a href="/Course/ExamListInCourse/@classId" class="list-group-item list-group-item-action">
                <i class="fas fa-list me-2"></i> Danh sách đề
            </a>
            <a href="/Course/StudentList/@classId" class="list-group-item list-group-item-action active">
                <i class="fas fa-users me-2"></i> Danh sách học sinh
            </a>
            <a href="/Course/Settings/@classId" id="settingsMenuItem" class="list-group-item list-group-item-action">
                <i class="fas fa-cog me-2"></i> Cài đặt
            </a>
        </div>
    </aside>

    <!-- Main -->
    <main class="flex-grow-1 p-4">

        <div class="top-bar">
            <div>
                <h3>Danh sách học sinh</h3>
                <small id="studentCount"></small>
            </div>

            <div>
                <button class="btn btn-outline-secondary me-2">
                    Xuất Excel
                </button>

                <button id="addStudentBtn" class="btn btn-primary">
                    + Thêm học sinh
                </button>
            </div>
        </div>

        <!-- Filter -->
        <div class="d-flex gap-3 mb-3">
            <input id="searchInput" class="form-control search-box"
                   placeholder="Tìm tên hoặc mã sinh viên..." />

            <select id="sortSelect" class="form-select" style="width:200px;">
                <option value="default">Sắp xếp: Mặc định</option>
                <option value="name_asc">Tên A → Z</option>
                <option value="name_desc">Tên Z → A</option>
                <option value="code_asc">Mã SV tăng dần</option>
                <option value="newest">Tham gia mới nhất</option>
            </select>
        </div>

        <!-- Table -->
        <div class="card p-3">
            <table class="table">
                <tr id="studentTableHead">
                    <th><input type="checkbox" id="checkAll"></th>
                    <th>STT</th>
                    <th>Mã SV</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                </tr>
                <tbody id="studentTableBody"></tbody>
            </table>
        </div>

    </main>
</div>
<script src="~/js/Course/Course.js"></script>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        const classId = @classId;
        CoursePage.initStudentPage(classId);
    });
</script>
