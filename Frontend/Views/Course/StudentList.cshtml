@{
    ViewData["Title"] = "Danh sách học sinh";
    var classId = ViewBag.ClassId ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}

<div class="d-flex" style="min-height: 100vh;">
    <!-- Sidebar -->
    <aside class="bg-light border-end" style="width: 250px;">
        <div class="p-3 border-bottom">
            <h5 class="mb-0">Quản lý lớp học</h5>
        </div>
        <div class="list-group list-group-flush">
            <a href="/Course/ExamListInCourse/@classId" class="list-group-item list-group-item-action">
                <i class="fas fa-list me-2"></i> Danh sách đề
            </a>
            <a href="/Course/StudentList/@classId" class="list-group-item list-group-item-action active">
                <i class="fas fa-users me-2"></i> Danh sách học sinh
            </a>
            <a href="/Course/Settings/@classId" id="settingsMenuItem" class="list-group-item list-group-item-action">
                <i class="fas fa-cog me-2"></i> Cài đặt
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow-1 p-4">

        <section class="mb-4">
            <h2>Danh sách học sinh trong lớp</h2>
        </section>

        <!-- Table -->
        <section class="card p-3">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Mã sinh viên</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Ngày tham gia</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody">
                        <tr>
                            <td colspan="5" class="text-center">Đang tải...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

@section Scripts {
    <script>
        const classId = @classId;
        const API_BASE = "https://localhost:7167";

        async function loadStudents() {
            const token = getToken();

            if (!token) {
                alert("Bạn chưa đăng nhập");
                window.location.href = "/Auth/Login";
                return;
            }

            try {
                const role = getUserRole();
                if (role === "Student") {
                    const settingsMenu = document.getElementById("settingsMenuItem");
                    if (settingsMenu) settingsMenu.style.display = 'none';
                }

                const response = await fetch(`${API_BASE}/api/Course/${classId}/students`, {
                    headers: { "Authorization": "Bearer " + token }
                });

                if (response.status === 401) {
                    alert("Phiên đăng nhập hết hạn");
                    removeToken();
                    window.location.href = "/Auth/Login";
                    return;
                }

                if (!response.ok) {
                    throw new Error("Không thể tải danh sách học sinh");
                }

                const students = await response.json();
                renderStudents(students);
            } catch (error) {
                console.error(error);
                document.getElementById("studentTableBody").innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center text-danger">Có lỗi xảy ra khi tải danh sách.</td>
                    </tr>
                `;
            }
        }

        function formatDateTime(dateString) {
            if (!dateString) return "-";
            return new Date(dateString).toLocaleString("vi-VN");
        }

        function renderStudents(students) {
            const tbody = document.getElementById("studentTableBody");
            tbody.innerHTML = "";

            if (!students || students.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center">
                            Chưa có học sinh nào tham gia lớp này.
                        </td>
                    </tr>
                `;
                return;
            }

            students.forEach((student, index) => {
                const row = document.createElement("tr");

                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${student.studentCode || '-'}</td>
                    <td>${student.fullName || '-'}</td>
                    <td>${student.email || '-'}</td>
                    <td>${formatDateTime(student.joinedAtUtc)}</td>
                `;

                tbody.appendChild(row);
            });
        }

        document.addEventListener("DOMContentLoaded", loadStudents);
    </script>
}
