@{
    ViewData["Title"] = "Danh sách đề trong lớp";
    var classId = ViewBag.ClassId ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}

<div class="d-flex" style="min-height: 100vh;">
    <!-- Sidebar -->
    <aside class="bg-light border-end" style="width: 250px;">
        <div class="p-3 border-bottom">
            <h5 class="mb-0">Quản lý lớp học</h5>
        </div>

        <div class="list-group list-group-flush">
            <a href="/Course/ExamListInCourse/@classId" class="list-group-item list-group-item-action active">
                <i class="fas fa-list me-2"></i> Danh sách đề
            </a>
            <a href="/Course/StudentList/@classId" class="list-group-item list-group-item-action">
                <i class="fas fa-users me-2"></i> Danh sách học sinh
            </a>
            <a href="/Course/Settings/@classId" id="settingsMenuItem" class="list-group-item list-group-item-action">
                <i class="fas fa-cog me-2"></i> Cài đặt
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow-1 p-4">

        <section class="mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2>Danh sách đề thi</h2>
            </div>

            <button class="btn btn-primary" id="createExamBtn">
                <i class="fas fa-plus"></i> Giao đề
            </button>
        </section>

        <!-- Filters -->
        <section class="card p-3 mb-4">
            <div class="row g-2">

                <!-- Chapter -->
                <div class="col-md-3">
                    <select id="chapterFilter" class="form-select">
                        <option value="">Tất cả chương</option>
                    </select>
                </div>

                <!-- Status -->
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="open">Mở</option>
                        <option value="upcoming">Sắp diễn ra</option>
                        <option value="closed">Đóng</option>
                    </select>
                </div>

                <!-- Search -->
                <div class="col-md-6">
                    <input id="searchFilter"
                           class="form-control"
                           placeholder="Tìm theo tên đề..." />
                </div>


            </div>
        </section>

        <!-- Table -->
        <section class="card p-3">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Tên đề</th>
                            <th>Khoảng thời gian</th>
                            <th>Thời lượng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="examTableBody">
                        <tr>
                            <td colspan="5" class="text-center">Đang tải...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>
<script src="~/js/Course/Course.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const classId = @classId; // Razor

        ExamPage.initExamList(classId);
    });
</script>