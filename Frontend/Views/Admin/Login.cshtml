@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đăng nhập Admin";
    ViewBag.HideHeader = true;
    ViewBag.HideSidebar = true;
    ViewBag.IsFullWidth = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/shells/shell-auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="brand-mark">M</div>
            <div class="title">MTCA</div>
            <div class="sub">Admin Console</div>
        </div>

        <form id="loginForm" class="auth-form">
            <div class="form-row">
                <label>Email</label>
                <input type="email" id="email" required />
            </div>
            <div class="form-row">
                <label>Mật khẩu</label>
                <div class="password-field">
                    <input type="password" id="password" required />
                    <button type="button" class="password-toggle" data-target="password" aria-label="Hiện mật khẩu" aria-pressed="false">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>
            <div id="loginError" class="muted" style="color:var(--danger);font-size:12px;"></div>
            <button type="submit" class="btn btn-primary" id="btnSubmit">Đăng nhập</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/login.js" asp-append-version="true"></script>
}
