@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Admin - MTCA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shells/shell-auth.css" asp-append-version="true" />
    @await Html.PartialAsync("_ApiConfig")
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-mark">M</div>
                <div class="title">MTCA</div>
                <div class="sub">Admin Console</div>
            </div>

            <form id="loginForm" class="auth-form">
                <div class="form-row">
                    <label>Email</label>
                    <input type="email" id="email" required />
                </div>
                <div class="form-row">
                    <label>Mật khẩu</label>
                    <input type="password" id="password" required />
                </div>
                <div id="loginError" class="muted" style="color:var(--danger);font-size:12px;"></div>
                <button type="submit" class="btn btn-primary" id="btnSubmit">Đăng nhập</button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Admin/login.js" asp-append-version="true"></script>
</body>
</html>
