@{
    ViewData["Title"] = "Đổi mật khẩu lần đầu";
    ViewBag.HideHeader = true;
    ViewBag.HideSidebar = true;
    ViewBag.IsFullWidth = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth/login.css" asp-append-version="true" />
}

<div class="login-container">
    <h2 class="login-title">Đổi mật khẩu lần đầu</h2>
    <p class="login-subtitle">Vui lòng đặt mật khẩu mới trước khi tiếp tục sử dụng hệ thống.</p>

    <form id="changePasswordFirstLoginForm">
        <div id="formMessage" class="mb-3 fw-bold" style="font-size: 0.9rem;"></div>

        <div class="mb-3">
            <label for="CurrentPassword" class="form-label">Mật khẩu hiện tại <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="password-field">
                <input id="CurrentPassword" type="password" class="form-control" placeholder="Mật khẩu hiện tại" required />
                <button type="button" class="password-toggle" data-target="CurrentPassword" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="field-error text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="NewPassword" class="form-label">Mật khẩu mới <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="password-field">
                <input id="NewPassword" type="password" class="form-control" placeholder="Mật khẩu mới" required minlength="8" maxlength="72" />
                <button type="button" class="password-toggle" data-target="NewPassword" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span id="NewPasswordError" class="field-error text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="password-field">
                <input id="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required minlength="8" maxlength="72" />
                <button type="button" class="password-toggle" data-target="ConfirmPassword" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="field-error text-danger"></span>
        </div>

        <button type="submit" class="btn btn-login" id="btnSubmit">Cập nhật mật khẩu</button>
    </form>
</div>

@section Scripts {
    <script src="~/js/Auth/changePasswordFirstLogin.js" asp-append-version="true"></script>
}
