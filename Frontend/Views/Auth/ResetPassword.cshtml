@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewBag.HideHeader = true;
    ViewBag.HideSidebar = true;
    ViewBag.IsFullWidth = true;
    var email = ViewData["Email"] as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth/login.css" asp-append-version="true" />
}

<div class="login-container">
    <h2 class="login-title">Đặt lại Mật Khẩu</h2>
    <p class="login-subtitle">Nhập mã OTP đã gửi đến hộp thư của bạn</p>

    <form id="resetPasswordForm">
        <div id="formMessage" class="mb-3 fw-bold" style="font-size: 0.9rem;"></div>

        <div class="mb-3">
            <label for="Email" class="form-label">Email</label>
            <input id="Email" type="email" class="form-control" value="@email" readonly />
        </div>

        <div class="mb-3">
            <label for="OtpCode" class="form-label">Mã OTP</label>
            <input id="OtpCode" type="text" class="form-control" placeholder="Nhập mã 6 số" required maxlength="6" pattern="\d{6}" title="Mã OTP phải là 6 chữ số" inputmode="numeric" autocomplete="one-time-code" />
        </div>

        <div class="mb-3">
            <label for="NewPassword" class="form-label">Mật khẩu mới</label>
            <input id="NewPassword" type="password" class="form-control" placeholder="Từ 8-72 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt" required minlength="8" maxlength="72" />
        </div>

        <div class="mb-3">
            <label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
            <input id="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required minlength="8" maxlength="72" />
        </div>

        <button type="submit" class="btn btn-login" id="btnSubmit">Xác nhận Đặt lại</button>
        <div class="text-center mt-3">
            <a href="/Auth/Login" class="forgot-password" style="text-decoration: underline;">Quay lại Đăng nhập</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/Auth/resetPassword.js" asp-append-version="true"></script>
}
