<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Console</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shells/shell-admin.css" asp-append-version="true" />
    @await Html.PartialAsync("_ApiConfig")
</head>
<body>
    <div class="shell">
        @await Html.PartialAsync("_SidebarAdmin")

        <main>
            @await Html.PartialAsync("_HeaderAdmin")

            <div class="page">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Libs -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Modal Scripts & Helpers -->
    <script src="~/js/Shared/modal.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Guard: Kick out if not admin -->
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (window.userReady) {
                await window.userReady;
                if (typeof window.getUserRole === 'function') {
                    const role = window.getUserRole();
                    if (role !== '3') { // RoleIds.Admin
                        window.location.href = '/Admin/Login';
                    }
                }
            } else {
                window.location.href = '/Admin/Login';
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
