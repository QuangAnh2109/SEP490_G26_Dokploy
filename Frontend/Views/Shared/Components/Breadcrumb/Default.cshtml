@model Frontend.ViewComponents.BreadcrumbItem[]
<div class="crumbs">
    @for (int i = 0; i < Model.Length; i++)
    {
        var item = Model[i];
        if (i > 0)
        {
            <span class="sep">/</span>
        }

        if (item.Url != null)
        {
            <a href="@item.Url">@item.Text</a>
        }
        else
        {
            <span class="current">@item.Text</span>
        }
    }
</div>
