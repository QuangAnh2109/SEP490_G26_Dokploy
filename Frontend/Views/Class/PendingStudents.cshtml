@{
    ViewData["Title"] = "Phê duyệt học sinh";
    var classId = ViewBag.ClassId ?? 0;
    ViewBag.IsFullWidth = true;
}
@section Styles {
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Class/class_sidebar.css" asp-append-version="true" />
}

<div class="class-wrapper">
    <!-- Sidebar -->
    <aside class="class-sidebar">
        <div class="mb-4">
            <h6 class="fw-bold text-primary mb-1">Quản lý lớp học</h6>
            <div class="text-muted small" id="sidebarClassName">---</div>
        </div>

        <div class="nav-section-title">Bài thi</div>
        <a href="/Class/ExamListInClass/@classId" class="sidebar-link">
            <i class="fas fa-list"></i> Danh sách đề
        </a>
        <a href="/PracticeExam/Setup?classId=@classId" class="sidebar-link" id="practiceMenuItem">
            <i class="fas fa-brain"></i> Luyện tập
        </a>
        <a href="/PracticeExam/History?classId=@classId" class="sidebar-link" id="practiceHistoryMenuItem">
            <i class="fas fa-chart-bar"></i> Kết quả
        </a>

        <div class="nav-section-title">Quản lý</div>
        <a href="/Class/StudentList/@classId" class="sidebar-link">
            <i class="fas fa-users"></i> Danh sách học sinh
        </a>
        <a href="/Class/PendingStudents/@classId" id="pendingMenuItem" class="sidebar-link active">
            <i class="fas fa-user-clock"></i> Phê duyệt học sinh
        </a>
        <a href="/Class/Settings/@classId" id="settingsMenuItem" class="sidebar-link">
            <i class="fas fa-cog"></i> Cài đặt
        </a>
    </aside>

    <!-- Main Content -->
    <main class="class-content">

        <section class="mb-4">
            <h2 class="fw-bold">Phê duyệt học sinh</h2>
            <p class="text-muted">Danh sách học sinh đang chờ phê duyệt để tham gia lớp.</p>
        </section>

        <!-- Tìm kiếm -->
        <section class="card p-3 mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" class="form-control" id="searchEmail" placeholder="Tìm theo Email...">
                </div>
                <div class="col-md-5">
                    <input type="text" class="form-control" id="searchStudentId" placeholder="Tìm theo Mã sinh viên...">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" onclick="filterStudents()"><i class="fas fa-search me-1"></i> Tìm</button>
                </div>
            </div>
        </section>

        <!-- Table -->
        <section class="card p-3">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Mã sinh viên</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody">
                        <tr>
                            <td colspan="5" class="text-center">Đang tải...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<!-- Template cho một học sinh chờ duyệt -->
<template id="pending-row-template">
    <tr>
        <td class="fw-bold student-index"></td>
        <td class="student-code"></td>
        <td class="student-name"></td>
        <td class="student-email"></td>
        <td class="student-action">
            <button class="btn btn-sm btn-success me-2 btn-approve" title="Cho phép">
                <i class="fas fa-check"></i>
            </button>
            <button class="btn btn-sm btn-danger btn-reject" title="Từ chối">
                <i class="fas fa-times"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <div id="classData" data-class-id="@classId" style="display: none;"></div>
    <script>
        const API_BASE = window.API_BASE_URL;
    </script>
    <script src="~/js/Class/pending_students.js" asp-append-version="true"></script>
}
