@{
    ViewData["Title"] = "Kết quả thi - Giáo viên";
    var examId = ViewBag.ExamId ?? 0;
    var classId = ViewBag.ClassId;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Analytics/exam_submit_results.css" asp-append-version="true" />
}

<main class="container-fluid p-4 text-dark" id="submitResultsRoot" data-exam-id="@examId" data-class-id="@(classId ?? "")">
    <div id="loadingState" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Đang tải thống kê nộp bài...</p>
    </div>

    <div id="errorState" class="text-center py-5" hidden>
        <i class="bi bi-exclamation-triangle text-warning error-icon"></i>
        <h5 class="mt-3">Không thể tải dữ liệu</h5>
        <p id="errorMessage" class="text-muted"></p>
    </div>

    <div id="contentArea" hidden>
        <div class="mb-4">
            <a href="#" id="backLink" class="text-decoration-none text-secondary mb-2 d-inline-block back-link">
                <i class="bi bi-arrow-left"></i> Danh sách kỳ thi
            </a>
            <h4 class="mb-1 fw-normal text-dark" id="examTitle">Kết quả thi</h4>
            <div class="text-secondary small d-flex flex-wrap gap-4 mt-2" id="examMeta">
                <span id="classInfo"></span>
                <span><strong>Thời gian:</strong> <span id="durationInfo"></span> phút</span>
                <span><strong>Số lần làm tối đa:</strong> <span id="maxAttemptsInfo"></span> lần</span>
                <span><strong>Đã nộp:</strong> <span id="submittedInfo"></span></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4 border-top pt-4 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-medium" id="selectedCount">Đã chọn 0 học sinh</span>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="input-group input-group-sm input-group-search search-width">
                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0 shadow-none" placeholder="Tìm MSSV, Họ tên...">
                </div>
                <select id="statusFilter" class="form-select form-select-sm shadow-none border text-secondary fw-medium filter-width">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Đã nộp">Đã nộp</option>
                    <option value="Đang làm">Đang làm</option>
                    <option value="Vắng thi">Vắng thi</option>
                </select>
                <button type="button" class="btn btn-outline-custom border text-secondary fw-medium btn-sm py-2 px-3" id="exportExcelBtn" disabled title="Chức năng sắp ra mắt">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất điểm (Excel)
                </button>
            </div>
        </div>

        <div class="bg-white border rounded-3 overflow-hidden">
            <table class="table table-hover mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th class="col-checkbox"><input class="form-check-input" type="checkbox" id="selectAll"></th>
                        <th class="col-code">MSSV</th>
                        <th>Họ và tên</th>
                        <th class="col-last-submit">Lần nộp cuối</th>
                        <th class="col-duration">Thời gian làm</th>
                        <th class="col-score">Điểm (Lần cuối)</th>
                        <th class="col-attempts">Số lần nộp</th>
                        <th class="col-status">Trạng thái</th>
                        <th class="col-action text-center">Chi tiết</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody"></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
            <span class="text-secondary back-link" id="paginationInfo">Hiển thị 0 học sinh</span>
            <nav id="paginationNav" aria-label="Phân trang">
                <ul class="pagination mb-0" id="paginationList"></ul>
            </nav>
        </div>
    </div>
</main>

<template id="student-row-template">
    <tr class="student-row">
        <td><input class="form-check-input row-checkbox" type="checkbox"></td>
        <td class="col-code"></td>
        <td class="col-name"></td>
        <td class="col-last-submit"></td>
        <td class="col-duration"></td>
        <td class="fw-bold col-score"></td>
        <td class="col-attempts"></td>
        <td class="col-status"></td>
        <td class="text-center col-action"></td>
    </tr>
</template>

<template id="history-row-template">
    <tr class="history-row d-none">
        <td colspan="9" class="border-top-0 pt-0 pb-4 px-0">
            <div class="history-padding">
                <h6 class="fw-bold mb-3 text-secondary history-title"></h6>
                <div class="row">
                    <div class="col-md-9">
                        <table class="table table-sm table-bordered bg-white mb-0 sub-table">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="fw-medium">Lần thi</th>
                                    <th class="fw-medium">Thời gian nộp</th>
                                    <th class="fw-medium">Thời gian làm</th>
                                    <th class="fw-medium">Điểm số</th>
                                    <th class="fw-medium text-center" style="width: 120px;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody class="history-tbody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </td>
    </tr>
</template>

<template id="history-record-template">
    <tr>
        <td class="col-attempt"></td>
        <td class="col-submitted"></td>
        <td class="col-duration"></td>
        <td class="col-score"></td>
        <td class="text-center col-action">
            <a href="#" class="btn btn-outline-primary btn-sm px-3 py-1 fw-medium btn-view" title="Xem chi tiết bài làm">Xem bài</a>
        </td>
    </tr>
</template>

<template id="pagination-item-template">
    <li class="page-item">
        <a class="page-link" href="#"></a>
    </li>
</template>

@section Scripts {
    <script src="~/js/Analytics/exam_submit_results.js" asp-append-version="true"></script>
}
