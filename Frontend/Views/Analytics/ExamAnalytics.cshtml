@{
    ViewData["Title"] = "Phân tích Kết quả Bài thi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Analytics/teacher_analytics.css" />
}

<main class="container-fluid px-3 px-md-4 py-4" id="analyticsRoot" data-exam-id="@ViewBag.ExamId">
    <!-- ── Loading ── -->
    <div id="analyticsLoading" class="analytics-loading">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-3 text-muted">Đang phân tích dữ liệu bài thi...</p>
    </div>

    <!-- ── Error State ── -->
    <div id="analyticsError" class="analytics-empty" hidden>
        <i class="bi bi-exclamation-triangle text-warning"></i>
        <h5>Không thể tải dữ liệu</h5>
        <p id="errorMessage" class="text-muted"></p>
    </div>

    <!-- ── Main Content ── -->
    <div id="analyticsContent" hidden>

        <!-- Header -->
        <header class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div>
                <h1 class="page-title mb-1" id="examTitle">Phân tích Bài thi</h1>
                <p class="text-muted mb-0"><i class="bi bi-person-badge"></i> Chế độ dành cho Giáo viên — Thống kê & Phân tích tổng quát</p>
            </div>
            <div id="quickStats" class="d-flex gap-4">
                <div class="text-center">
                    <div class="h3 fw-bold mb-0 text-primary" id="totalSubmissions">—</div>
                    <small class="text-muted text-uppercase fw-bold stat-quick-label">Lượt nộp</small>
                </div>
                <div class="text-center">
                    <div class="h3 fw-bold mb-0 text-success" id="avgScoreQuick">—</div>
                    <small class="text-muted text-uppercase fw-bold stat-quick-label">Điểm TB</small>
                </div>
            </div>
        </header>

        <!-- Stat Cards -->
        <div class="row g-4 mb-5">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card stat-success">
                    <div class="stat-value" id="avgScore">0</div>
                    <div class="stat-label">Hiệu suất Trung bình</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card stat-primary">
                    <div class="stat-value" id="maxScore">0</div>
                    <div class="stat-label">Thành tích Cao nhất</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card stat-danger">
                    <div class="stat-value" id="minScore">0</div>
                    <div class="stat-label">Điểm số Thấp nhất</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card stat-info">
                    <div class="stat-value" id="medianScore">0</div>
                    <div class="stat-label">Điểm số Trung vị</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- LEFT COLUMN -->
            <div class="col-12 col-xl-8">

                <div class="analytics-card">
                    <div class="card-header">
                        <i class="bi bi-graph-up-arrow text-primary"></i> Phân tích Phổ điểm Lớp học
                    </div>
                    <div class="card-body">
                        <canvas id="scoreDistChart" height="100"></canvas>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="analytics-card h-100">
                            <div class="card-header">
                                <i class="bi bi-pie-chart text-success"></i> Năng lực theo Chương
                            </div>
                            <div class="card-body">
                                <canvas id="chapterChart" height="200"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="analytics-card h-100">
                            <div class="card-header">
                                <i class="bi bi-layers-half text-warning"></i> Năng lực theo Độ khó
                            </div>
                            <div class="card-body">
                                <canvas id="difficultyChart" height="200"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="analytics-card">
                    <div class="card-header">
                        <i class="bi bi-lightning-charge text-danger"></i> Nhóm Câu hỏi cần Lưu tâm
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="analytics-table" id="hardestTable">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Nội dung câu hỏi</th>
                                        <th>Chương</th>
                                        <th>Mức độ</th>
                                        <th class="text-center">Tỉ lệ đúng</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="analytics-card">
                    <div class="card-header">
                        <i class="bi bi-person-lines-fill text-primary"></i> Bảng Kết quả Chi tiết
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="analytics-table" id="studentTable">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Học sinh</th>
                                        <th class="text-center">Điểm số</th>
                                        <th>Ngày hoàn thành</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-12 col-xl-4">
                <div class="analytics-card" style="position: sticky; top: 1.5rem;">
                    <div class="card-header">
                        <i class="bi bi-magic text-warning"></i> Trình phân tích AI & Gợi ý
                    </div>
                    <div class="card-body" id="recommendationsBox">
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-muted"></div>
                            <span class="ms-2 text-muted">Đang tổng hợp dữ liệu...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- ════════════════════════════════════════
     TEMPLATES — JS sẽ clone các template này
     ════════════════════════════════════════ -->

<!-- Template: Hàng bảng câu hỏi khó nhất -->
<template id="tpl-hardest-row">
    <tr>
        <td data-col="index"></td>
        <td><math-span data-col="content"></math-span></td>
        <td data-col="chapter"></td>
        <td data-col="difficulty"></td>
        <td><span class="score-badge" data-col="accuracy"></span></td>
    </tr>
</template>

<!-- Template: Hàng bảng sinh viên -->
<template id="tpl-student-row">
    <tr>
        <td data-col="index"></td>
        <td data-col="name"></td>
        <td><span class="score-badge" data-col="score"></span></td>
        <td data-col="date"></td>
    </tr>
</template>

<!-- Template: Đề xuất -->
<template id="tpl-rec-item">
    <div class="rec-item"></div>
</template>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script defer src="https://unpkg.com/mathlive"></script>
    <script src="~/js/Analytics/exam_analytics.js"></script>
}

