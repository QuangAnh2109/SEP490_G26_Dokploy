@{
    ViewData["Title"] = "Làm bài thi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Exam/exam_taking.css" />
    <style>
        math-field::part(virtual-keyboard-toggle) {
            display: none;
        }

        math-field::part(menu-toggle) {
            display: none;
        }

        #question-block-mcq {
            list-style-type: upper-alpha;
        }

        math-field {
            max-width: 100%;
            overflow-x: auto;
            display: block;
        }
    </style>
}

<main class="page-shell py-4" id="examWorkspace">
    <div class="container-fluid px-3 px-md-4">

        @* ── Header ── *@
        <section class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h1 class="page-title">Kiểm tra</h1>
                <div class="badge bg-info mt-2" style="font-size: 1rem;">
                    <i class="bi bi-file-earmark-text"></i> Mã đề thi: <span id="examCodeSpan">---</span>
                </div>
            </div>
            <div class="soft-card">
                <div class="summary-label">Thời gian còn lại</div>
                <div class="countdown" id="countdownTimer">40:00</div>
            </div>
        </section>

        <div class="row g-3">
            <div class="col-12 col-xl-8" id="question-loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>

            @* ── Question Area (single question) ── *@
            <div class="col-12 col-xl-8" id="question-area" hidden>
                <div id="question-header" hidden>
                    <div id="question-title"></div>
                    <div class="mb-3">
                        <math-span id="question-stem" style="vertical-align:middle; font-size:1.1rem; border:none; padding:0; min-height:auto;"></math-span>
                    </div>
                </div>

                @* ══════ Câu hỏi trắc nghiệm (MCQ) ══════ *@
                <ul id="question-block-mcq" hidden>
                </ul>

                @* ══════ Câu hỏi điền chỗ trống (Fill in Blank) ══════ *@
                <div class="d-flex align-items-center gap-2" hidden id="question-block-fib">
                    <math-field hidden read-only id="question-block-fib-field"></math-field>
                </div>

            </div>

            @* ── Sidebar ── *@
            <div class="col-12 col-xl-4">
                <aside class="panel-card mb-3">
                    <h2 class="panel-title">Điều hướng câu hỏi</h2>
                    <div class="question-nav mb-2" id="questionNav">
                        <!-- Navigation buttons will go here -->
                    </div>
                    <p class="form-note mb-0 text-success">Hệ thống sẽ tự động lưu bài</p>
                </aside>

                <div class="toolbar d-flex gap-2 mt-3 mb-3">
                    <button class="btn btn-danger flex-grow-1" id="btnSubmitExam" onclick="confirmSubmit()">Nộp bài</button>
                </div>

                <div id="inputTypeContainer" class="soft-card" hidden>
                    <div class="summary-label text-center mb-2">Giới hạn nhập liệu</div>
                    <table class="table table-bordered table-sm text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Loại dữ liệu</th>
                            </tr>
                        </thead>
                        <tbody id="inputTypeBody">
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</main>

<template id="mcq-template">
    <li>
        <label>
            <input type="checkbox" name="answer">
            <math-span></math-span>
        </label>
    </li>
</template>

<template id="input-limit-btn-template">
    <tr>
        <td>
            <button type="button" class="btn btn-outline-primary btn-sm w-100"></button>
        </td>
    </tr>
</template>

<template id="input-limit-text-template">
    <tr>
        <td class="align-middle">
            <span class="text-muted fw-bold"></span>
        </td>
    </tr>
</template>

@section Scripts {
    <!-- MathLive for math rendering -->
    <script defer src="https://unpkg.com/mathlive"></script>
    <script>
        var regexPlaceholder = /\\placeholder\[([^\]]+)\]\{\}/;
        var exam;
        var selectionHandler = null;
        const fillInBlank = "FillInBlank";
        const multipleChoice = "MultipleChoice";
        var questionNumber = 1;

        // ── Timer variables ──
        var timerInterval = null;
        var remainingSeconds = 0;

        // ── Lưu đáp án học sinh: Map<string, string> ──
        // key: questionAnswerId (string)
        // value: response (string) — rỗng với MCQ, latex với FIB
        var studentAnswers = new Map();

        var questionHeader;
        var questionLoading;
        var questionArea;
        var questionStem;
        var questionTitle;
        var questionMcq;
        var questionBlockFib;

        document.addEventListener('DOMContentLoaded', async () => {
            questionHeader = document.getElementById('question-header');
            questionLoading = document.getElementById('question-loading');
            questionArea = document.getElementById('question-area');
            questionStem = document.getElementById('question-stem');
            questionTitle = document.getElementById('question-title');
            questionMcq = document.getElementById('question-block-mcq');
            questionBlockFib = document.getElementById('question-block-fib');
            questionBlockFibField = document.getElementById('question-block-fib-field');
            //Lấy giá trị examId
            const examId = new URLSearchParams(window.location.search).get('examId');

            //Kiểm tra tính hợp lệ
            if (!examId || isNaN(examId)) {
                showToast("Không tìm thấy mã bài thi hợp lệ trong URL.", "error");
                return;
            }

            apiClient.post(`/api/student/exams/${examId}/take`)
                .then((response) => {
                    exam = response;
                    console.log(exam);
                    
                    // Update exam code
                    const codeSpan = document.getElementById('examCodeSpan');
                    if (codeSpan && exam.code) {
                        codeSpan.textContent = exam.code;
                    }

                    buildQuestionNav(exam.questions.length);
                    goToQuestion(1);

                    // ── Khởi tạo bộ đếm thời gian ──
                    startCountdown(exam.duration);
                })
                .catch((error) => {
                    showToast("Lỗi: " + error.message, "error");
                });
        });

        function renderQuestion(question){
            // remove event cũ nếu có
            if (selectionHandler) {
                questionBlockFibField.removeEventListener("selection-change", selectionHandler);
                selectionHandler = null;
            }

            //Ẩn câu hỏi cũ và hiện loading
            questionHeader.hidden = true;
            questionArea.hidden = true;
            questionLoading.hidden = false;
            questionBlockFib.hidden = true;
            questionMcq.hidden = true;
            questionBlockFibField.hidden = true;

            //Truyền nội dung câu hỏi
            if(question.questionType == fillInBlank){
                var questionContent = JSON.parse(question.questionContent);
                questionStem.textContent = questionContent.stem;
                questionStem.render?.();
                questionTitle.textContent = "Câu " + questionNumber;
                document.getElementById('question-block-fib-field').value = questionContent.frame;
                questionBlockFib.hidden = false;
                questionBlockFibField.hidden = false;

                // ── Khôi phục đáp án FIB đã lưu ──
                    question.answers.forEach(answer => {
                        const answerId = String(answer.questionAnswerId);
                        if (studentAnswers.has(answerId)) {
                            const placeholderMatch = answer.content.match(regexPlaceholder);
                            if (placeholderMatch) {
                                const promptId = placeholderMatch[1];
                                questionBlockFibField.setPromptValue(promptId, studentAnswers.get(answerId), { silenceNotifications: true });
                            }
                        }
                    });

                selectionHandler = () => {
                    let placeholderId = [];
                    for (const item of question.answers) {
                        placeholderId.push(item.content.match(regexPlaceholder)?.[1]);
                    }
                    selectPlaceholder(questionBlockFibField, placeholderId);
                };

                questionBlockFibField.addEventListener("selection-change", selectionHandler);
            }
            else if(question.questionType == multipleChoice){
                questionStem.textContent = question.questionContent;
                questionStem.render?.();
                questionTitle.textContent = "Câu " + questionNumber;
                questionMcq.hidden = false;

                var template = document.getElementById("mcq-template");

                questionMcq.innerHTML = "";

                question.answers.forEach((answer) => {

                    var newOption = template.content.cloneNode(true);

                    var li = newOption.querySelector("li");

                    var checkbox = li.querySelector("input");
                    var answerId = String(answer.questionAnswerId);
                    checkbox.value = answerId;

                    // ── Khôi phục trạng thái checked từ Map ──
                    if (studentAnswers.has(answerId)) {
                        checkbox.checked = true;
                    }

                    // ── Lưu/xóa đáp án MCQ khi checkbox thay đổi ──
                    checkbox.addEventListener('change', function () {
                        if (this.checked) {
                            studentAnswers.set(answerId, '');
                        } else {
                            studentAnswers.delete(answerId);
                        }
                        console.log('studentAnswers:', Object.fromEntries(studentAnswers));
                    });

                    var mathSpan = li.querySelector("math-span");
                    mathSpan.textContent = answer.content;
                    mathSpan.render?.();

                    questionMcq.appendChild(newOption);
                });
            }

            console.log(studentAnswers);

            //Hiện câu hỏi
            questionLoading.hidden = true;
            questionHeader.hidden = false;
            questionArea.hidden = false;
        }

        function buildQuestionNav(total) {
            const nav = document.getElementById('questionNav');
            nav.innerHTML = '';
            for (let i = 1; i <= total; i++) {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-primary btn-sm m-1';
                btn.textContent = i;
                btn.style.minWidth = '40px';
                btn.addEventListener('click', () => goToQuestion(i));
                nav.appendChild(btn);
            }
        }

        function goToQuestion(num) {
            // ── Lưu đáp án câu hiện tại trước khi chuyển ──
            saveCurrentAnswers();

            questionNumber = num;
            renderQuestion(exam.questions[num-1]);

            document.querySelectorAll('#questionNav button').forEach((btn, idx) => {
                if (idx + 1 === questionNumber) {
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-primary');
                } else {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                }
            });
        }

        // ══════════════════════════════════════════
        // ── Lưu đáp án học sinh ──
        // ══════════════════════════════════════════

        function saveCurrentAnswers() {
            if (!exam) return;
            const question = exam.questions[questionNumber - 1];
            if (!question) return;

            if (question.questionType === multipleChoice) {
                // MCQ: duyệt tất cả checkbox, cập nhật Map
                const checkboxes = questionMcq.querySelectorAll('input[name="answer"]');
                checkboxes.forEach(cb => {
                    const answerId = String(cb.value);
                    if (cb.checked) {
                        studentAnswers.set(answerId, '');
                    } else {
                        studentAnswers.delete(answerId);
                    }
                });
            }
            else if (question.questionType === fillInBlank) {
                // FIB: dùng getPrompts() của MathLive để lấy danh sách prompt ID
                const promptIds = questionBlockFibField.getPrompts();
                promptIds.forEach(promptId => {
                    // Tìm answer tương ứng với promptId
                    const answer = question.answers.find(a => {
                        const match = a.content.match(regexPlaceholder);
                        return match && match[1] === promptId;
                    });
                    if (answer) {
                        const latex = questionBlockFibField.getPromptValue(promptId, 'latex');
                        const answerId = String(answer.questionAnswerId);
                        if (latex && latex.trim() !== '') {
                            studentAnswers.set(answerId, latex);
                        } else {
                            studentAnswers.delete(answerId);
                        }
                    }
                });
            }

            console.log('studentAnswers saved:', Object.fromEntries(studentAnswers));
        }

        function selectPlaceholder(mathField, placeholderId){
            const pos = mathField.position;
            let isInsidePlaceholder = false;

            for (const id of placeholderId) {
                const range = mathField.getPromptRange(id);

                if (range && pos >= range[0] && pos <= range[1]) {
                    console.log(id);
                    isInsidePlaceholder = true;

                    const currentQuestion = exam.questions[questionNumber - 1];
                    const answer = currentQuestion.answers.find(a => {
                        const match = a.content.match(regexPlaceholder);
                        return match && match[1] === id;
                    });

                    const container = document.getElementById('inputTypeContainer');
                    const tbody = document.getElementById('inputTypeBody');
                    const btnTemplate = document.getElementById('input-limit-btn-template');
                    const textTemplate = document.getElementById('input-limit-text-template');

                    if (container && tbody) {
                        tbody.innerHTML = '';
                        if (answer && answer.inputTypes && answer.inputTypes.length > 0) {
                            answer.inputTypes.forEach(it => {
                                if (it.groupType === 'Sets') {
                                    const newRow = textTemplate.content.cloneNode(true);
                                    const span = newRow.querySelector('span');
                                    span.textContent = 'Tập hợp: ' + it.name;
                                    tbody.appendChild(newRow);
                                } else {
                                    const newRow = btnTemplate.content.cloneNode(true);
                                    const btn = newRow.querySelector('button');
                                    btn.textContent = it.name;
                                    
                                    btn.onmousedown = function(e) {
                                        // Check user intent to not lose focus
                                        e.preventDefault();
                                    };
                                    btn.onclick = function() {
                                        mathField.focus();
                                        mathField.insert('\\text{' + it.name + '}');
                                    };
                                    tbody.appendChild(newRow);
                                }
                            });
                            container.hidden = false;
                        } else {
                            container.hidden = true;
                        }
                    }
                    break;
                }
            }

            if (!isInsidePlaceholder) {
                const container = document.getElementById('inputTypeContainer');
                if (container) container.hidden = true;
            }
        }

        // ══════════════════════════════════════════
        // ── Bộ đếm thời gian nộp bài ──
        // ══════════════════════════════════════════

        function startCountdown(durationMinutes) {
            // Dừng timer cũ nếu có
            if (timerInterval) clearInterval(timerInterval);

            remainingSeconds = Math.max(0, Math.floor(durationMinutes * 60));
            updateTimerDisplay();

            timerInterval = setInterval(() => {
                remainingSeconds--;

                if (remainingSeconds <= 0) {
                    remainingSeconds = 0;
                    clearInterval(timerInterval);
                    updateTimerDisplay();
                    // Hết giờ → tự động nộp bài
                    showToast("Đã hết thời gian làm bài! Hệ thống sẽ tự động nộp bài.", "warning", 5000);
                    submitExam(true);
                    return;
                }

                updateTimerDisplay();
            }, 1000);
        }

        /**
         * Cập nhật hiển thị bộ đếm trên giao diện.
         */
        function updateTimerDisplay() {
            const minutes = Math.floor(remainingSeconds / 60);
            const seconds = remainingSeconds % 60;
            const display = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

            const el = document.getElementById('countdownTimer');
            if (el) {
                el.textContent = display;

                // Đổi màu khi còn ít thời gian (≤ 5 phút)
                if (remainingSeconds <= 300) {
                    el.style.color = '#dc3545';
                } else {
                    el.style.color = '';
                }
            }
        }

        /**
         * Xác nhận trước khi nộp bài (cho nút Nộp bài).
         */
        function confirmSubmit() {
            showConfirm('Bạn có chắc chắn muốn nộp bài?', 'Xác nhận nộp bài', () => submitExam(true));
        }

        function submitExam(isFinal) {
            // Lưu đáp án câu hiện tại trước khi nộp
            saveCurrentAnswers();

            if (isFinal) {
                // Dừng bộ đếm khi nộp bài chính thức
                if (timerInterval) clearInterval(timerInterval);
            }

            // Lấy examId từ URL
            const examId = parseInt(new URLSearchParams(window.location.search).get('examId'));

            // Xây dựng danh sách StudentAnswerDto từ studentAnswers Map
            const studentAnswerDtos = [];
            studentAnswers.forEach((response, questionAnswerId) => {
                console.log('Map key:', questionAnswerId, 'type:', typeof questionAnswerId, 'parseInt:', parseInt(questionAnswerId));
                studentAnswerDtos.push({
                    questionAnswerId: parseInt(questionAnswerId),
                    response: response === '' ? null : response
                });
            });

            // Tạo SubmitExamRequest
            const requestBody = {
                examId: examId,
                studentAnswers: studentAnswerDtos,
                submit: isFinal
            };

            console.log('submitExam request:', requestBody);
            console.log('submitExam JSON:', JSON.stringify(requestBody));

            // Disable nút nộp bài để tránh nhấn nhiều lần
            const btnSubmit = document.getElementById('btnSubmitExam');
            if (btnSubmit) btnSubmit.disabled = true;

            apiClient.post('/api/submission/submit', requestBody)
                .then((response) => {
                    console.log('submitExam response:', response);

                    if (isFinal) {
                        // Hiển thị thông báo nộp bài
                        const submittedAt = new Date(response.submittedAtUtc);
                        const formattedTime = submittedAt.toLocaleString('vi-VN', {
                            timeZone: 'Asia/Ho_Chi_Minh',
                            year: 'numeric', month: '2-digit', day: '2-digit',
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });

                        if (response.isLate) {
                            showToast(`Nộp bài trễ! Thời điểm ghi nhận: ${formattedTime}. Bài làm của bạn đã được nộp nhưng đã quá thời hạn.`, "warning", 8000);
                        } else {
                            showToast(`Nộp bài thành công! Thời điểm ghi nhận: ${formattedTime}`, "success", 5000);
                        }

                        // Chuyển hướng hoặc vô hiệu hóa giao diện sau khi nộp
                        document.getElementById('examWorkspace').style.pointerEvents = 'none';
                        document.getElementById('examWorkspace').style.opacity = '0.6';
                    } else {
                        // Cập nhật lựa chọn thành công (không cần thông báo)
                        if (btnSubmit) btnSubmit.disabled = false;
                    }
                })
                .catch((error) => {
                    console.error('submitExam error:', error);
                    showToast('Lỗi khi nộp bài: ' + error.message, 'error');
                    if (btnSubmit) btnSubmit.disabled = false;

                    // Nếu nộp bài cuối cùng thất bại, khởi động lại timer
                    if (isFinal && remainingSeconds > 0) {
                        startCountdown(remainingSeconds / 60);
                    }
                });
        }
    </script>
}