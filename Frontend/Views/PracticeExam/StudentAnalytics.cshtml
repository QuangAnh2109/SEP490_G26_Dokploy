@{
    ViewData["Title"] = "Phân tích Luyện tập của tôi";
    var classId = ViewBag.ClassId ?? 0;
    ViewBag.IsFullWidth = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Class/class_sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/PracticeExam/practice_analytics.css" asp-append-version="true" />
}

<div class="class-wrapper">
    <aside class="class-sidebar">
        <div class="mb-4">
            <h6 class="fw-bold text-primary mb-1">Quản lý lớp học</h6>
            <div class="text-muted small" id="sidebarClassName">---</div>
        </div>

        <div class="nav-section-title">Bài thi</div>
        <a href="/Class/ExamListInClass/@classId" class="sidebar-link">
            <i class="fas fa-list"></i> Danh sách đề
        </a>
        <a href="/PracticeExam/Setup?classId=@classId" class="sidebar-link" id="practiceMenuItem">
            <i class="fas fa-brain"></i> Luyện tập
        </a>
        <a href="/PracticeExam/History?classId=@classId" class="sidebar-link" id="practiceHistoryMenuItem">
            <i class="fas fa-chart-bar"></i> Kết quả
        </a>
        <a href="/PracticeExam/ClassAnalytics?classId=@classId" class="sidebar-link d-none" id="classAnalyticsMenuItem">
            <i class="fas fa-chart-line"></i> Phân tích luyện tập
        </a>
        <a href="/PracticeExam/StudentAnalytics?classId=@classId" class="sidebar-link active d-none" id="studentAnalyticsMenuItem">
            <i class="fas fa-chart-line"></i> Phân tích của tôi
        </a>

        <div class="nav-section-title">Quản lý</div>
        <a href="/Class/StudentList/@classId" class="sidebar-link">
            <i class="fas fa-users"></i> Danh sách học sinh
        </a>
        <a href="/Class/PendingStudents/@classId" id="pendingMenuItem" class="sidebar-link">
            <i class="fas fa-user-clock"></i> Phê duyệt học sinh
        </a>
        <a href="/Class/Settings/@classId" id="settingsMenuItem" class="sidebar-link">
            <i class="fas fa-cog"></i> Cài đặt
        </a>
    </aside>

    <main class="class-content" id="analyticsRoot" data-class-id="@classId">

        <!-- Loading -->
        <div id="analyticsLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Đang phân tích dữ liệu luyện tập...</p>
        </div>

        <!-- Error -->
        <div id="analyticsError" class="text-center py-5 d-none">
            <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
            <h5>Không thể tải dữ liệu</h5>
            <p id="errorMessage" class="text-muted"></p>
        </div>

        <!-- Content -->
        <div id="analyticsContent" class="d-none">

            <!-- Header -->
            <section class="mb-4 d-flex justify-content-between align-items-start pt-4 pb-2 flex-wrap gap-2">
                <div>
                    <h2 class="mb-1 fw-bold">Phân tích Luyện tập của tôi</h2>
                    <p class="text-muted mb-0 small">
                        <i class="fas fa-user-graduate me-1"></i>
                        Môn: <strong id="headerSubject"></strong>
                    </p>
                </div>
                <a href="/PracticeExam/Setup?classId=@classId" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Luyện tập mới
                </a>
            </section>

            <!-- Stat Cards -->
            <section class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="pa-stat-card pa-stat-primary">
                        <div class="pa-stat-value" id="statTotalSessions">—</div>
                        <div class="pa-stat-label">Buổi luyện tập</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="pa-stat-card pa-stat-info">
                        <div class="pa-stat-value" id="statTotalQuestions">—</div>
                        <div class="pa-stat-label">Câu đã làm</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="pa-stat-card pa-stat-success">
                        <div class="pa-stat-value" id="statAccuracy">—</div>
                        <div class="pa-stat-label">Tỉ lệ đúng</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="pa-stat-card pa-stat-warning">
                        <div class="pa-stat-value" id="statLastPractice">—</div>
                        <div class="pa-stat-label">Luyện gần nhất</div>
                    </div>
                </div>
            </section>

            <!-- No data state -->
            <div id="noDataState" class="text-center py-5 d-none">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">Bạn chưa hoàn thành buổi luyện tập nào cho môn này.</p>
                <a href="/PracticeExam/Setup?classId=@classId" class="btn btn-primary mt-2">
                    <i class="fas fa-play me-1"></i> Bắt đầu luyện tập
                </a>
            </div>

            <div id="chartsArea">
                <!-- Trend Chart -->
                <section class="card mb-4">
                    <div class="card-header fw-semibold">
                        <i class="fas fa-chart-line me-2 text-primary"></i>Tiến độ luyện tập theo thời gian
                    </div>
                    <div class="card-body">
                        <canvas id="trendChart" height="100"></canvas>
                    </div>
                </section>

                <div class="row g-4 mb-4">
                    <!-- Chapter Chart -->
                    <div class="col-12 col-lg-7">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">
                                <i class="fas fa-book me-2 text-info"></i>Hiệu suất theo Chương
                            </div>
                            <div class="card-body">
                                <canvas id="chapterChart" height="220"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Difficulty Chart -->
                    <div class="col-12 col-lg-5">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">
                                <i class="fas fa-layer-group me-2 text-success"></i>Theo Độ khó
                            </div>
                            <div class="card-body">
                                <canvas id="difficultyChart" height="220"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chapter Table -->
                <section class="card mb-4">
                    <div class="card-header fw-semibold">
                        <i class="fas fa-table me-2 text-secondary"></i>Chi tiết theo Chương
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Chương</th>
                                        <th class="text-center">Câu đã làm</th>
                                        <th class="text-center">Đúng</th>
                                        <th class="text-center">Tỉ lệ đúng</th>
                                        <th class="text-center">Mức độ</th>
                                    </tr>
                                </thead>
                                <tbody id="chapterTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- Recommendations -->
                <section class="card mb-4">
                    <div class="card-header fw-semibold">
                        <i class="fas fa-lightbulb me-2 text-warning"></i>Gợi ý cá nhân
                    </div>
                    <div class="card-body" id="recommendationsList"></div>
                </section>
            </div><!-- /chartsArea -->

        </div><!-- /analyticsContent -->
    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const classId = @classId;
    </script>
    <script src="~/js/PracticeExam/student_analytics.js" asp-append-version="true"></script>
}
