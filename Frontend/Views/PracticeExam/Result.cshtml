@{
    ViewData["Title"] = "Kết quả luyện tập";
    var submissionId = ViewBag.SubmissionId ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/PracticeExam/practice_exam.css" />
    <style>
        math-field::part(virtual-keyboard-toggle) {
            display: none;
        }

        math-field::part(menu-toggle) {
            display: none;
        }
    </style>
}

<div class="container py-4">
    <div id="resultLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div id="resultContent" class="d-none">

        <div class="result-summary-card">
            <div class="row align-items-center">
                <div class="col-md-4 text-center">
                    <div class="score-circle" id="scoreCircle">
                        <span class="score-value" id="scoreValue">0%</span>
                        <span class="score-label">Tỉ lệ đúng</span>
                    </div>
                </div>
                <div class="col-md-8">
                    <h3 class="mb-3">Kết quả luyện tập</h3>
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="text-muted small">Tổng câu hỏi</div>
                            <div class="fw-bold fs-5" id="totalQuestions">0</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Đúng</div>
                            <div class="fw-bold fs-5 text-success" id="correctCount">0</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Sai</div>
                            <div class="fw-bold fs-5 text-danger" id="wrongCount">0</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted small me-3">
                            <i class="fas fa-clock me-1"></i>Bắt đầu: <span id="startTime"></span>
                        </span>
                        <span class="text-muted small">
                            <i class="fas fa-check-circle me-1"></i>Nộp bài: <span id="endTime"></span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="result-summary-card">
            <h5 class="mb-3"><i class="fas fa-chart-bar me-2"></i>Thống kê theo chương</h5>
            <div id="chapterStatsContainer"></div>
        </div>

        <div class="d-flex gap-2 mb-3 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary active" data-filter="all" onclick="filterAnswers('all', this)">
                Tất cả
            </button>
            <button class="btn btn-sm btn-outline-success" data-filter="correct" onclick="filterAnswers('correct', this)">
                <i class="fas fa-check me-1"></i>Đúng
            </button>
            <button class="btn btn-sm btn-outline-danger" data-filter="wrong" onclick="filterAnswers('wrong', this)">
                <i class="fas fa-times me-1"></i>Sai
            </button>
        </div>

        <div id="answerReviewContainer"></div>

        <div class="d-flex justify-content-center gap-3 mt-4 mb-4">
            <a href="#" onclick="goBackToHistory(event)" class="btn btn-outline-secondary px-4">
                <i class="fas fa-arrow-left me-1"></i> Quay lại lịch sử
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script defer src="https://unpkg.com/mathlive"></script>
    <script>
        const submissionId = @submissionId;
        let resultData = null;
        document.addEventListener('DOMContentLoaded', () => {
            loadResult();
            loadBreadcrumb();
        });
        function goBackToHistory(e) {
            e.preventDefault();
            const classId = sessionStorage.getItem('currentPracticeClassId');
            if (classId) {
                window.location.href = `/PracticeExam/History?classId=${classId}`;
            } else {
                window.location.href = `/Class/ClassList`;
            }
        }

        async function loadBreadcrumb() {
            const classId = sessionStorage.getItem('currentPracticeClassId');
            if (!classId) return;

            try {
                const data = await apiClient.get(`/api/class/${classId}/settings`);
                if (typeof setBreadcrumb === "function") {
                    setBreadcrumb([
                        { text: "Lớp học", url: "/Class/ClassList" },
                        { text: data.className || ('Lớp ' + classId), url: "/Class/ExamListInClass/" + classId + (data.className ? "?className=" + encodeURIComponent(data.className) : "") },
                        { text: "Lịch sử luyện tập", url: "/PracticeExam/History?classId=" + classId },
                        { text: "Chi tiết bài làm", url: null }
                    ]);
                }
            } catch {
                if (typeof setBreadcrumb === "function") {
                    setBreadcrumb([
                        { text: "Lớp học", url: "/Class/ClassList" },
                        { text: 'Lớp ' + classId, url: "/Class/ExamListInClass/" + classId },
                        { text: "Lịch sử luyện tập", url: "/PracticeExam/History?classId=" + classId },
                        { text: "Chi tiết bài làm", url: null }
                    ]);
                }
            }
        }

        async function loadResult() {
            try {
                resultData = await apiClient.get(`/api/practice/result/${submissionId}`);

                renderResult(resultData);
                document.getElementById('resultContent').classList.remove('d-none');
            } catch (error) {
                if (error.xhr && error.xhr.status === 401) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                showToast(error.message || 'Lỗi tải kết quả', 'error');
            } finally {
                document.getElementById('resultLoading').classList.add('d-none');
            }
        }

        function renderResult(data) {
            // Score circle
            const rate = data.accuracyRate;
            const circle = document.getElementById('scoreCircle');
            circle.classList.add(rate >= 80 ? 'excellent' : rate >= 50 ? 'good' : 'poor');
            document.getElementById('scoreValue').textContent = `${rate}%`;

            // Stats
            document.getElementById('totalQuestions').textContent = data.totalQuestions;
            document.getElementById('correctCount').textContent = data.correctCount;
            document.getElementById('wrongCount').textContent = data.wrongCount;

            // Time
            document.getElementById('startTime').textContent = formatDateTime(data.createdAtUtc);
            document.getElementById('endTime').textContent = formatDateTime(data.submittedAtUtc);

            // Chapter stats
            renderChapterStats(data.chapterStats);

            // Answer review
            renderAnswerReview(data.answerReview);
        }

        function renderChapterStats(stats) {
            const container = document.getElementById('chapterStatsContainer');
            if (!stats || stats.length === 0) {
                container.innerHTML = '<p class="text-muted">Không có dữ liệu.</p>';
                return;
            }

            container.innerHTML = stats.map(ch => {
                const rate = ch.overallAccuracyRate;
                const barClass = rate < 50 ? 'weak' : rate < 80 ? 'medium' : 'strong';
                return `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-medium">${escapeHtml(ch.chapterName)}</span>
                        <span class="badge ${rate >= 80 ? 'bg-success' : rate >= 50 ? 'bg-warning text-dark' : 'bg-danger'}">${rate}%</span>
                    </div>
                    <div class="proficiency-bar mb-3">
                        <div class="proficiency-fill ${barClass}" style="width: ${rate}%"></div>
                    </div>
                `;
            }).join('');
        }

        function renderAnswerReview(reviews) {
            const container = document.getElementById('answerReviewContainer');
            if (!reviews || reviews.length === 0) {
                container.innerHTML = '<p class="text-muted">Không có câu hỏi.</p>';
                return;
            }

            container.innerHTML = reviews.map(q => {
                const badge = q.isCorrect
                    ? '<span class="badge bg-success">Đúng</span>'
                    : '<span class="badge bg-danger">Sai</span>';

                const diffBadge = getDifficultyBadge(q.difficulty);

                // BE serialize đồng nhất {stem, frame} cho mọi loại câu (QuestionService.cs).
                // FIB hiển thị stem + frame; MCQ chỉ hiển thị stem (frame = null cho MCQ).
                let contentDisplayHtml = q.questionContent;
                try {
                    const parsed = JSON.parse(q.questionContent);
                    if (parsed && typeof parsed.stem === 'string') {
                        contentDisplayHtml = q.questionType === "FillInBlank"
                            ? `${parsed.stem}<br/>${parsed.frame || ''}`
                            : parsed.stem;
                    }
                } catch (e) { /* legacy plain string — giữ nguyên */ }

                const optionsHtml = q.options.map(opt => {
                    let className = 'answer-option not-selected';
                    let icon = '';

                    let isStudentCorrect = false;
                    if (opt.isSelected) {
                        if (q.questionType === "FillInBlank" && opt.correctAnswer && opt.studentResponse) {
                            isStudentCorrect = opt.studentResponse.trim().toLowerCase() === opt.correctAnswer.trim().toLowerCase();
                        } else {
                            isStudentCorrect = opt.isCorrect;
                        }
                    }

                    if (q.questionType === "FillInBlank") {
                        if (opt.isSelected && isStudentCorrect) {
                            className = 'answer-option student-correct';
                            icon = '<i class="fas fa-check-circle text-success me-2"></i>';
                        } else if (opt.isSelected && !isStudentCorrect) {
                            className = 'answer-option student-wrong';
                            icon = '<i class="fas fa-times-circle text-danger me-2"></i>';
                        } else {
                            className = 'answer-option correct-answer';
                            icon = '<i class="fas fa-check text-success me-2"></i>';
                        }
                    } else {
                        // Logic cho MCQ (Trắc nghiệm)
                        if (opt.isSelected && opt.isCorrect) {
                            className = 'answer-option student-correct';
                            icon = '<i class="fas fa-check-circle text-success me-2"></i>';
                        } else if (opt.isSelected && !opt.isCorrect) {
                            className = 'answer-option student-wrong';
                            icon = '<i class="fas fa-times-circle text-danger me-2"></i>';
                        } else if (!opt.isSelected && opt.isCorrect) {
                            className = 'answer-option correct-answer';
                            icon = '<i class="fas fa-check text-success me-2"></i>';
                        }
                    }

                    // Tùy chỉnh hiển thị text bên trong
                    let contentDisplay = opt.content || '';
                    if (q.questionType === "FillInBlank") {
                        let placeholderLabel = "Ô trống";
                        let match = contentDisplay.match(/\\?placeholder\[([^\]]+)\](?:\{\})?/);
                        if (match) placeholderLabel = `Ô trống [${match[1]}]`;

                        let exactAnswer = opt.correctAnswer ? `<math-span>${opt.correctAnswer}</math-span>` : '';
                        contentDisplay = `<strong>${placeholderLabel}</strong>: ${exactAnswer}`;
                    }

                    if (q.questionType === "FillInBlank") {
                        if (opt.studentResponse) {
                            contentDisplay += ` <span>(Bạn điền: <math-span>${escapeHtml(opt.studentResponse)}</math-span>)</span>`;
                        } else {
                            contentDisplay += ` <span class="text-muted">(Chưa điền)</span>`;
                        }
                    }
                    // MCQ: icon ✓/✗ trên option đã đủ chỉ rõ đúng/sai — không thêm annotation gây nhiễu.

                    // Dùng div hay math-span để render
                    if (q.questionType === "FillInBlank") {
                        return `<div class="${className} py-2 d-flex align-items-center flex-wrap gap-2">${icon} <span>${contentDisplay}</span></div>`;
                    } else {
                        return `<div class="${className}">${icon} <math-span>${contentDisplay}</math-span></div>`;
                    }
                }).join('');

                return `
                    <div class="answer-review-card ${q.isCorrect ? 'correct' : 'wrong'}" data-correct="${q.isCorrect}">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong>Câu ${q.questionOrder}</strong>
                                ${badge} ${diffBadge}
                                <span class="text-muted small ms-2">${escapeHtml(q.chapterName)}</span>
                            </div>
                        </div>
                        <div class="mb-2" style="font-size: 1.1rem; line-height: 1.6;">
                            <math-span>${contentDisplayHtml}</math-span>
                        </div>
                        ${optionsHtml}
                    </div>
                `;
            }).join('');
        }

        function filterAnswers(filter, btn) {
            document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('.answer-review-card').forEach(card => {
                if (filter === 'all') card.style.display = '';
                else if (filter === 'correct') card.style.display = card.dataset.correct === 'true' ? '' : 'none';
                else card.style.display = card.dataset.correct === 'false' ? '' : 'none';
            });
        }

        function getDifficultyBadge(diff) {
            const map = {
                1: '<span class="badge bg-info">Nhận biết</span>',
                2: '<span class="badge bg-primary">Thông hiểu</span>',
                3: '<span class="badge bg-warning text-dark">Vận dụng</span>',
                4: '<span class="badge bg-danger">Vận dụng cao</span>'
            };
            return map[diff] || '';
        }


    </script>
}