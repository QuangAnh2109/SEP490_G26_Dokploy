@{
    ViewData["Title"] = "Lịch sử luyện tập";
    var classId = ViewBag.ClassId ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/PracticeExam/practice_exam.css" />
}

<div class="container py-4">
    <section class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-history me-2 text-primary"></i>Lịch sử luyện tập</h2>
            <p class="text-muted mb-0">Xem lại các bài luyện tập đã làm</p>
        </div>
        <a href="/PracticeExam/Setup?classId=@classId" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Luyện tập mới
        </a>
    </section>

    <!-- Loading -->
    <div id="historyLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Content -->
    <div id="historyContent" class="d-none">
        <div id="historyList"></div>
        <div id="historyEmpty" class="text-center py-5 d-none">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted">Bạn chưa có bài luyện tập nào.</p>
            <a href="/PracticeExam/Setup?classId=@classId" class="btn btn-primary mt-2">
                <i class="fas fa-play me-1"></i> Bắt đầu luyện tập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const classId = @classId;

        document.addEventListener('DOMContentLoaded', () => {
            sessionStorage.setItem('currentPracticeClassId', classId);
            loadHistory();
        });

        async function loadHistory() {
            const token = getToken();
            if (!token) { window.location.href = '/Auth/Login'; return; }

            try {
                const res = await fetch(`${API_BASE_URL}/api/practice/history?classId=${classId}`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!res.ok) {
                    showToast('Lỗi tải lịch sử', 'error');
                    return;
                }

                const history = await res.json();
                renderHistory(history);
                document.getElementById('historyLoading').classList.add('d-none');
                document.getElementById('historyContent').classList.remove('d-none');
            } catch (err) {
                showToast('Lỗi: ' + err.message, 'error');
            }
        }

        function renderHistory(history) {
            const list = document.getElementById('historyList');
            const empty = document.getElementById('historyEmpty');

            if (!history || history.length === 0) {
                empty.classList.remove('d-none');
                return;
            }

            list.innerHTML = history.map(h => {
                const isSubmitted = h.status === 'Đã nộp';
                const statusClass = isSubmitted ? 'submitted' : 'in-progress';
                const date = new Date(h.createdAtUtc).toLocaleString('vi-VN', {
                    timeZone: 'Asia/Ho_Chi_Minh',
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    hour: '2-digit', minute: '2-digit'
                });

                const chapters = h.chapterNames && h.chapterNames.length > 0
                    ? h.chapterNames.join(', ') : 'N/A';

                let actionBtn = '';
                if (isSubmitted) {
                    actionBtn = `
                        <a href="/PracticeExam/Result?submissionId=${h.submissionId}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-eye me-1"></i> Xem kết quả
                        </a>
                    `;
                } else {
                    actionBtn = `
                        <a href="/PracticeExam/TakePractice?submissionId=${h.submissionId}" class="btn btn-sm btn-warning">
                            <i class="fas fa-redo me-1"></i> Làm tiếp
                        </a>
                    `;
                }

                const scoreHtml = isSubmitted && h.accuracyRate !== null
                    ? `<span class="badge ${h.accuracyRate >= 80 ? 'bg-success' : h.accuracyRate >= 50 ? 'bg-warning text-dark' : 'bg-danger'}">${h.accuracyRate}% (${h.correctCount}/${h.totalQuestions})</span>`
                    : '';

                return `
                    <div class="history-item">
                        <div style="flex: 1;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <strong>${escapeHtml(chapters)}</strong>
                                <span class="history-status ${statusClass}">${h.status}</span>
                                ${scoreHtml}
                            </div>
                            <div class="text-muted small">
                                <i class="fas fa-calendar me-1"></i>${date}
                                &nbsp;&nbsp;
                                <i class="fas fa-list me-1"></i>${h.totalQuestions} câu
                                ${h.subjectName ? '&nbsp;&nbsp;<i class="fas fa-book me-1"></i>' + escapeHtml(h.subjectName) : ''}
                            </div>
                        </div>
                        <div>${actionBtn}</div>
                    </div>
                `;
            }).join('');
        }
    </script>
}

