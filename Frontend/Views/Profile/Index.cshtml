@{
    ViewData["Title"] = "Profile";
}
<style>
    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
<div class="container mt-4">

    <div class="row">

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">

                    <div class="nav flex-column nav-pills">

                        <a class="nav-link active" id="tabProfileBtn">
                            Thông tin cá nhân
                        </a>

                        <a class="nav-link" id="tabPasswordBtn">
                            Đổi mật khẩu
                        </a>

                    </div>

                </div>
            </div>
        </div>


        <div class="col-md-9">

            <div class="card">

                <div class="card-body">

                    <!-- PROFILE -->
                    <div id="profileTab">

                        <h5 class="mb-3">Thông tin cá nhân</h5>

                        <form id="profileForm">

                            <div class="mb-3">
                                <label class="form-label">Họ và tên</label>
                                <input id="fullName" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input id="email" class="form-control" readonly>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input id="phoneNumber" class="form-control">
                            </div>

                            <div class="mb-3" id="studentIdGroup" hidden>
                                <label class="form-label">Mã số sinh viên</label>
                                <input id="studentId" class="form-control">
                            </div>

                            <button id="saveProfileBtn" type="submit" class="btn btn-primary" disabled>
                                Lưu thay đổi
                            </button>

                        </form>

                    </div>


                    <!-- CHANGE PASSWORD -->
                    <div id="passwordTab" style="display:none">

                        <h5 class="mb-3">Đổi mật khẩu</h5>

                        <form id="changePasswordForm">

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu hiện tại</label>
                                <input id="currentPassword" type="password" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu mới</label>
                                <input id="newPassword" type="password" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Xác nhận mật khẩu</label>
                                <input id="confirmPassword" type="password" class="form-control" required>
                            </div>

                            <button id="changePasswordBtn" type="submit" class="btn btn-primary" disabled>
                                Cập nhật mật khẩu
                            </button>

                        </form>

                    </div>


                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script src="~/js/Validations/site.js"></script>
    <script src="~/js/Profile/Profile.js"></script>

    <script>

        document.getElementById("tabProfileBtn").onclick = function(){

        document.getElementById("profileTab").style.display = "block";
        document.getElementById("passwordTab").style.display = "none";

        this.classList.add("active");
        document.getElementById("tabPasswordBtn").classList.remove("active");

        }

        document.getElementById("tabPasswordBtn").onclick = function(){

        document.getElementById("profileTab").style.display = "none";
        document.getElementById("passwordTab").style.display = "block";

        this.classList.add("active");

        document.getElementById("tabProfileBtn").classList.remove("active");

        }
                $("#profileForm input").on("input", function(){

            const changed =
                $("#fullName").val() !== originalProfile.fullName ||
                $("#phoneNumber").val() !== originalProfile.phoneNumber ||
                $("#studentId").val() !== originalProfile.studentId;

            $("#saveProfileBtn").prop("disabled", !changed);

        });
    </script>
}